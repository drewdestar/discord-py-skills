# --- machine-readable output (--json) ---
# In --json mode stdout is exactly one JSON object (the envelope) and
# nothing else; all human logs, progress, and warnings go to stderr,
# and prompts are disabled. JSON_MODE is set once by main().
JSON_MODE = False
WARNINGS: list = []


def out(*args, **kwargs) -> None:
    """Human output: stdout, unless --json mode (stdout is one JSON object)."""
    if not JSON_MODE:
        print(*args, **kwargs)


def warn(message: str) -> None:
    """A warning: collected for the --json envelope AND printed to stderr."""
    WARNINGS.append(message)
    print(message, file=sys.stderr)


def emit(obj: dict) -> None:
    """Print exactly one JSON object to stdout (--json mode only)."""
    print(json.dumps(obj))

