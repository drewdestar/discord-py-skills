    "search": cmd_search,
    "info": cmd_info,
    "install": cmd_install,
    "uninstall": cmd_uninstall,
    "list": cmd_list,
    "agents": cmd_agents,
    "update": cmd_update,
    "init": cmd_init,
    "add": cmd_add,
    "build": cmd_build,
    "version": cmd_version,
    "help": cmd_help,
}


def _envelope(command: str, data: dict | None, error: NewrError | None) -> dict:
    """The --json envelope: one JSON object, success or failure."""
    return {
        "ok": error is None,
        "command": command,
        "newr": VERSION,
        "data": data,
        "warnings": list(WARNINGS),
        "error": None if error is None else {
            "code": error.code,
            "message": str(error),
            "hint": error.hint or "",
        },
    }


def main(argv: list) -> int:
    global JSON_MODE
    argv = list(argv)
    if "--json" in argv:
        JSON_MODE = True
        argv = [a for a in argv if a != "--json"]
    if not argv or argv[0] in ("-h", "--help"):
        data = cmd_help([])
        if JSON_MODE:
            emit(_envelope("help", data, None))
        return 0
    cmd = argv[0]
    if cmd in ("-v", "--version"):
        data = cmd_version([])
        if JSON_MODE:
            emit(_envelope("version", data, None))
        return 0
    fn = COMMANDS.get(cmd)
    if fn is None:
        err = NewrUsageError("unknown command '%s'. Run `newr help`." % cmd)
        if JSON_MODE:
            emit(_envelope(cmd, None, err))
        else:
            print("newr: %s" % err, file=sys.stderr)
        return 1
    try:
        data = fn(argv[1:])
    except NewrError as exc:
        if JSON_MODE:
            emit(_envelope(cmd, None, exc))
        else:
            print("newr: %s" % exc, file=sys.stderr)
        return _EXIT_CODES.get(exc.code, 1)
    if JSON_MODE:
        emit(_envelope(cmd, data, None))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
