class NewrError(Exception):
    """A user-facing failure: print the message, exit 1."""


class NewrLangError(NewrError):
    """A .newr source error. The message already carries "line N"."""

    def __init__(self, line: int, message: str):
        super().__init__("line %d: %s" % (line, message))
        self.line = line


# --- the .newr language ---
# A tiny line-based language for defining a Discord bot. Full syntax
# in docs/NEWR-LANG.md. It lives in this file on purpose: newr is
# one file, so `curl | sh` installs and `npx github:` keep working
# with no extra module to fetch.

_NEWR_COMMAND_NAME = re.compile(r"^[a-z][a-z0-9_]*$")
_NEWR_BLOCK_OPEN = re.compile(r"^(bot|command|event)\s+(.+):$")
_NEWR_KEY_VALUE = re.compile(r"^([a-z_]+):\s*(.*)$")
# Placeholders allowed in each reply/log context. A reply to a
# command runs with an interaction, so it can name the user, the
# server, and the channel. A ready log has no user or server. A
# member-join reply runs with a member, so it can name the user and
# the server, but there is no channel in context.
_NEWR_PLACEHOLDERS = {
    "command": {"user", "guild", "channel"},
    "ready": {"bot"},
    "member_join": {"user", "guild"},
}
_NEWR_BOT_KEYS = {"description"}
_NEWR_COMMAND_KEYS = {"description", "reply", "ephemeral"}
_NEWR_EVENT_KEYS = {"ready": {"log"}, "member_join": {"reply"}}


def _newr_unquote(value: str, line_no: int) -> str:
    """One double-quoted string value. Escapes: \" \\ \n."""
    if len(value) < 2 or not value.startswith('"') or not value.endswith('"'):
        raise NewrLangError(line_no, "expected a quoted string, got %s" % value)
    out: list = []
    i = 1
    while i < len(value) - 1:
        ch = value[i]
        if ch == "\\":
            if i + 1 >= len(value) - 1:
                raise NewrLangError(line_no, "dangling backslash in string")
            nxt = value[i + 1]
            if nxt == '"':
                out.append('"')
            elif nxt == "\\":
                out.append("\\")
            elif nxt == "n":
                out.append("\n")
            else:
                raise NewrLangError(line_no, "unknown escape \\%s" % nxt)
            i += 2
        elif ch == '"':
            raise NewrLangError(line_no, "unescaped quote inside string")
        else:
            out.append(ch)
            i += 1
    return "".join(out)


def _newr_check_placeholders(text: str, context: str, line_no: int) -> None:
    """Every {name} in text must be allowed in this context."""
    allowed = _NEWR_PLACEHOLDERS[context]
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == "{":
            end = text.find("}", i)
            if end < 0:
                raise NewrLangError(line_no, "unclosed placeholder in %r" % text)
            name = text[i + 1:end]
            if name not in allowed:
                raise NewrLangError(
                    line_no, "unknown placeholder {%s} (allowed here: %s)"
                    % (name, ", ".join(sorted(allowed))))
            i = end + 1
        elif ch == "}":
            raise NewrLangError(line_no, "stray } in %r" % text)
        else:
            i += 1


def parse_newr(text: str, source_name: str = "") -> dict:
    """Parse .newr source into {"bot", "commands", "events"}.

    Raises NewrLangError naming the line on the first problem.
    Anything the parser does not understand is an error: it never
    silently ignores a line."""
    parsed: dict = {"bot": None, "commands": [], "events": []}
    block: dict | None = None  # {"kind", "line", "data"}

    def finish_block():
        nonlocal block
        if block is None:
            return
        kind = block["kind"]
        data = block["data"]
        if kind == "command" and data.get("reply") is None:
            raise NewrLangError(
                block["line"], "command %r has no reply" % data["name"])
        if kind == "event" and data["kind"] == "ready" and data.get("log") is None:
            raise NewrLangError(block["line"], "ready event has no log line")
        if kind == "event" and data["kind"] == "member_join" and data.get("reply") is None:
            raise NewrLangError(
                block["line"], "member_join event has no reply")
        if kind == "bot":
            parsed["bot"] = data
        elif kind == "command":
            parsed["commands"].append(data)
        else:
            parsed["events"].append(data)
        block = None

    for line_no, raw in enumerate(text.splitlines(), 1):
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        leading = raw[:len(raw) - len(raw.lstrip(" \t"))]
        if "\t" in leading:
            raise NewrLangError(line_no, "tab indentation is not allowed; use spaces")
        indent = len(raw) - len(raw.lstrip(" "))
        if indent not in (0, 2):
            raise NewrLangError(
                line_no, "expected 0 or 2 spaces of indentation, got %d" % indent)
        if indent == 2:
            if block is None:
                raise NewrLangError(line_no, "indented line outside any block")
            match = _NEWR_KEY_VALUE.match(stripped)
            if not match:
                raise NewrLangError(line_no, "expected `key: value`, got %r" % stripped)
            key, value = match.group(1), match.group(2)
            kind = block["kind"]
            data = block["data"]
            allowed = (_NEWR_BOT_KEYS if kind == "bot"
                       else _NEWR_COMMAND_KEYS if kind == "command"
                       else _NEWR_EVENT_KEYS[data["kind"]])
            if key not in allowed:
                raise NewrLangError(
                    line_no, "unknown key %r in %s block" % (key, kind))
            if key == "ephemeral":
                if value not in ("true", "false"):
                    raise NewrLangError(
                        line_no, "ephemeral must be true or false, got %r" % value)
                data["ephemeral"] = value == "true"
            else:
                parsed_value = _newr_unquote(value, line_no)
                context = ("command" if kind == "command"
                           else data["kind"] if kind == "event" else "ready")
                if key in ("reply", "log"):
                    _newr_check_placeholders(parsed_value, context, line_no)
                data[key] = parsed_value
            continue
        # Top-level block opener.
        match = _NEWR_BLOCK_OPEN.match(stripped)
        if not match:
            raise NewrLangError(line_no, "expected a block like `command ping:`, got %r"
                                % stripped)
        keyword, head = match.group(1), match.group(2)
        finish_block()
        if keyword == "bot":
            if parsed["bot"] is not None:
                raise NewrLangError(line_no, "duplicate bot block")
            name = _newr_unquote(head, line_no)
            if not 1 <= len(name) <= 32:
                raise NewrLangError(line_no, "bot name must be 1-32 characters")
            block = {"kind": "bot", "line": line_no,
                     "data": {"name": name, "description": None}}
        elif keyword == "command":
            if parsed["bot"] is None:
                raise NewrLangError(
                    line_no, "no bot block yet: the bot block must come first")
            if not _NEWR_COMMAND_NAME.match(head):
                raise NewrLangError(
                    line_no, "invalid command name %r (lowercase letters, digits, "
                    "underscores, starting with a letter)" % head)
            if any(c["name"] == head for c in parsed["commands"]):
                raise NewrLangError(line_no, "duplicate command %r" % head)
            block = {"kind": "command", "line": line_no,
                     "data": {"name": head, "description": head,
                              "reply": None, "ephemeral": False}}
        else:  # event
            if parsed["bot"] is None:
                raise NewrLangError(
                    line_no, "no bot block yet: the bot block must come first")
            if head not in ("ready", "member_join"):
                raise NewrLangError(line_no, "unknown event %r" % head)
            block = {"kind": "event", "line": line_no,
                     "data": {"kind": head}}
    finish_block()
    if parsed["bot"] is None:
        raise NewrLangError(1, "no bot block: a .newr file starts with `bot \"Name\":`")
    # Drop the None reply placeholder: a command that reaches here
    # always has one (finish_block enforces it).
    return parsed


def _newr_escape_dq(text: str) -> str:
    """Escape text for a double-quoted Python string literal."""
    return (text.replace("\\", "\\\\").replace('"', '\\"')
            .replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t"))


def _newr_dq(text: str) -> str:
    """A plain string as a double-quoted Python literal."""
    return '"%s"' % _newr_escape_dq(text)


def _newr_fstring(text: str, mapping: dict) -> str:
    """A reply/log string as a Python f-string literal. Placeholders
    become {expression}; every other character is literal text."""
    out: list = ['f"']
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == "{":
            end = text.find("}", i)
            out.append("{%s}" % mapping[text[i + 1:end]])
            i = end + 1
        else:
            out.append(_newr_escape_dq(ch))
            i += 1
    out.append('"')
    return "".join(out)


def compile_newr(parsed: dict, source_name: str = "") -> str:
    """Compile parsed .newr into runnable discord.py source."""
    bot = parsed["bot"]
    commands = parsed["commands"]
    events = parsed["events"]
    ready = next((e for e in events if e["kind"] == "ready"), None)
    join = next((e for e in events if e["kind"] == "member_join"), None)
    lines: list = []
    add = lines.append
    add("# Generated by newr from %s — do not edit by hand." % source_name)
    add("# Edit the .newr file and rebuild with: newr build %s" % source_name)
    if bot.get("description"):
        add("# %s" % bot["description"].replace("\n", " "))
    add("")
    add("import logging")
    add("import os")
    add("")
    add("import discord")
    add("from discord import app_commands")
    add("from discord.ext import commands")
    add("")
    add("logging.basicConfig(")
    add('    level=logging.INFO,')
    add('    format="%(asctime)s %(levelname)s %(name)s: %(message)s",')
    add(")")
    add('log = logging.getLogger("%s")' % bot["name"].lower())
    add("")
    add("")
    add("class Bot(commands.Bot):")
    add("    def __init__(self) -> None:")
    add("        intents = discord.Intents.default()")
    if join is not None:
        add("        intents.members = True")
    add('        super().__init__(command_prefix="!", intents=intents)')
    add("")
    add("    async def setup_hook(self) -> None:")
    add("        await self.tree.sync()")
    add('        log.info("Commands synced globally.")')
    if ready is not None:
        add("")
        add("    async def on_ready(self) -> None:")
        add("        log.info(%s)" % _newr_fstring(ready["log"], {"bot": "self.user"}))
    if join is not None:
        add("")
        add("    async def on_member_join(self, member: discord.Member) -> None:")
        add("        channel = member.guild.system_channel")
        add("        if channel is not None:")
        add("            await channel.send(%s)" % _newr_fstring(
            join["reply"], {"user": "member.mention",
                           "guild": "member.guild.name"}))
    add("")
    add("")
    add("bot = Bot()")
    for cmd in commands:
        add("")
        add("")
        add('@bot.tree.command(name=%s, description=%s)'
            % (_newr_dq(cmd["name"]), _newr_dq(cmd["description"])))
        add("async def cmd_%s(interaction: discord.Interaction) -> None:" % cmd["name"])
        mapping = {
            "user": "interaction.user.mention",
            "guild": 'interaction.guild.name if interaction.guild else "DM"',
            "channel": "_channel_text(interaction.channel)",
        }
        call = "    await interaction.response.send_message(%s" % _newr_fstring(
            cmd["reply"], mapping)
        if cmd["ephemeral"]:
            call += ", ephemeral=True"
        add(call + ")")
    add("")
    add("")
    add("@bot.tree.error")
    add("async def on_app_command_error(interaction: discord.Interaction,")
    add("                               error: app_commands.AppCommandError) -> None:")
    add('    log.warning("Command failed: %s", error)')
    add('    message = "Sorry, that command hit a problem. Try again."')
    add("    try:")
    add("        if interaction.response.is_done():")
    add("            await interaction.followup.send(message, ephemeral=True)")
    add("        else:")
    add("            await interaction.response.send_message(message, ephemeral=True)")
    add("    except discord.HTTPException:")
    add('        log.warning("Could not answer the failed command.")')
    add("")
    add("")
    add("def _channel_text(channel) -> str:")
    add('    """The channel as text: its mention, its name, or ""."""')
    add("    if channel is None:")
    add('        return ""')
    add('    return getattr(channel, "mention", None) or str(channel)')
    add("")
    add("")
    add("def main() -> None:")
    add('    token = os.environ.get("DISCORD_TOKEN")')
    add("    if not token:")
    add('        raise SystemExit("set the DISCORD_TOKEN environment variable")')
    add("    bot.run(token)")
    add("")
    add("")
    add('if __name__ == "__main__":')
    add("    main()")
    add("")
    return "\n".join(lines)


def cmd_build(args: list) -> int:
    check = "--check" in args
    rest = [a for a in args if a != "--check"]
    output = None
    files: list = []
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg in ("-o", "--output") and i + 1 < len(rest):
            output = rest[i + 1]
            i += 2
        elif arg.startswith("--output="):
            output = arg[len("--output="):]
            i += 1
        elif arg.startswith("-o") and len(arg) > 2:
            output = arg[2:]
            i += 1
        else:
            files.append(arg)
            i += 1
    if len(files) != 1:
        raise NewrError("usage: newr build [--check] <file.newr> [-o <file.py>]")
    src = Path(files[0])
    if not src.is_file():
        raise NewrError("no such file: %s" % src)
    try:
        text = src.read_text(encoding="utf-8")
    except UnicodeDecodeError as exc:
        raise NewrError("could not read %s as UTF-8 (%s)" % (src, exc))
    try:
        parsed = parse_newr(text, str(src))
    except NewrLangError as exc:
        raise NewrError("%s: %s" % (src, exc))
    code = compile_newr(parsed, str(src))
    if check:
        print("ok: %s (%d command(s), %d event(s))"
              % (src, len(parsed["commands"]), len(parsed["events"])))
        return 0
    dest = Path(output) if output else src.with_suffix(".py")
    dest.write_text(code, encoding="utf-8")
    print("built %s from %s" % (dest, src))
    return 0


def home() -> Path:
    return Path(os.environ.get("NEWR_HOME", str(Path.home() / ".newr")))


def skills_dir() -> Path:
    return home() / "skills"


def registry_cache() -> Path:
    return home() / "registry.json"


def local_source() -> Path | None:
    """A local checkout of the repo, if one is available.

    NEWR_LOCAL_SOURCE wins. Otherwise, if this script lives in a
    directory that contains registry.json (a clone of the repo),
    that directory is the source. An installed copy in ~/.newr/bin
    has no registry.json next to it, so it uses the network.
    """
    env = os.environ.get("NEWR_LOCAL_SOURCE")
    if env:
        path = Path(env)
        if (path / "registry.json").is_file():
            return path
        raise NewrError("NEWR_LOCAL_SOURCE %s has no registry.json" % env)
    here = Path(__file__).resolve().parent
    if (here / "registry.json").is_file():
        return here
    return None


def fetch_url(url: str, dest: Path) -> None:
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "newr/" + VERSION})
        with urllib.request.urlopen(req, timeout=30) as resp, open(dest, "wb") as f:
            shutil.copyfileobj(resp, f)
    except Exception as exc:  # network, DNS, HTTP errors: one clean message
        raise NewrError("could not fetch %s (%s)" % (url, exc))


def load_registry(refresh: bool = False) -> dict:
    """The package registry: local checkout, else the cached copy,
    else a fresh download. A failed download falls back to the cache
    with a warning instead of dying."""
    source = local_source()
    if source is not None:
        return json.loads((source / "registry.json").read_text(encoding="utf-8"))
    cache = registry_cache()
    if refresh or not cache.is_file():
        cache.parent.mkdir(parents=True, exist_ok=True)
        tmp = cache.with_suffix(".tmp")
        try:
            fetch_url(os.environ.get("NEWR_REGISTRY_URL", REGISTRY_URL), tmp)
        except NewrError:
            if cache.is_file():
                print("warning: registry download failed, using cached copy", file=sys.stderr)
                return json.loads(cache.read_text(encoding="utf-8"))
            raise
        tmp.replace(cache)
    return json.loads(cache.read_text(encoding="utf-8"))


def agent_table(registry: dict) -> dict:
    """Agent targets: the registry's "agents" section wins; the
    built-in table is the fallback for old cached registries."""
    table = registry.get("agents")
    if isinstance(table, dict) and table:
        return table
    return BUILTIN_AGENTS


def expand_user_dir(value: str) -> Path:
    return Path(os.path.expanduser(value))


def agent_dirs(agent: str, table: dict, project: bool) -> list:
    entry = table.get(agent, {})
    key = "project" if project else "user"
    raw = entry.get(key, [])
    if project:
        return [Path.cwd() / d for d in raw]
    return [expand_user_dir(d) for d in raw]


def is_conventions_agent(agent: str, table: dict) -> bool:
    return bool(table.get(agent, {}).get("conventions", False))


def detect_agents(table: dict) -> list:
    """Agents whose marker exists on this machine: a $HOME path
    (dir or file) or a binary on $PATH."""
    found = []
    for name, entry in table.items():
        for marker in entry.get("detect", []):
            if marker.startswith("~/"):
                if expand_user_dir(marker).exists():
                    found.append(name)
                    break
            elif shutil.which(marker):
                found.append(name)
                break
    return found


def resolve_agent_spec(spec: str, table: dict) -> list:
    """One --agent value into agent names. 'all' is every agent
    except aider (aider has no skill dirs); 'auto' is every agent
    detected on this machine. Comma-separated and repeatable names
    are accepted; 'devin' is an alias for 'windsurf'."""
    wanted: list = []
    for part in spec.split(","):
        name = AGENT_ALIASES.get(part.strip().lower(), part.strip().lower())
        if not name:
            continue
        if name == "all":
            wanted.extend(n for n in table if not is_conventions_agent(n, table))
        elif name == "auto":
            wanted.extend(detect_agents(table))
        elif name in table:
            wanted.append(name)
        else:
            raise NewrError(
                "unknown agent '%s'. Run `newr agents` to see the supported agents."
                % part.strip()
            )
    seen = set()
    return [n for n in wanted if not (n in seen or seen.add(n))]


def packages(registry: dict) -> dict:
    return {p["name"]: p for p in registry.get("packages", [])}


def resolve(name: str, registry: dict) -> dict:
    """One package by name. 'all' and the repo name mean every skill."""
    if name in ("all", "discord-py-skills"):
        return {"name": "all", "type": "bundle", "version": registry.get("version", "?"),
                "description": "all seven skills", "path": ""}
    found = packages(registry).get(name)
    if found is None:
        raise NewrError("no package named '%s'. Run `newr search` to see what exists." % name)
    return found


def package_source(registry: dict) -> Path:
    """A directory tree holding the repo contents: the local checkout,
    or a freshly downloaded tarball (caller owns the temp dir)."""
    source = local_source()
    if source is not None:
        return source
    tmp = Path(tempfile.mkdtemp(prefix="newr-"))
    archive = tmp / "repo.tar.gz"
    fetch_url(os.environ.get("NEWR_TARBALL_URL", TARBALL_URL), archive)
    try:
        with tarfile.open(archive, "r:gz") as tf:
            tf.extractall(tmp)
    except Exception as exc:
        raise NewrError("could not unpack the repo archive (%s)" % exc)
    roots = [d for d in tmp.iterdir() if d.is_dir()]
    if not roots:
        raise NewrError("downloaded repo archive is empty")
    return roots[0]


def dest_for(pkg: dict, target: Path | None) -> Path:
    if target is not None:
        return target
    if pkg["type"] == "template":
        return Path.cwd() / pkg["name"]
    return skills_dir() / pkg["name"]


def receipt_at(dest: Path) -> dict | None:
    receipt = dest / RECEIPT
    if receipt.is_file():
        return json.loads(receipt.read_text(encoding="utf-8"))
    return None


def installed_receipt(pkg_name: str) -> dict | None:
    return receipt_at(skills_dir() / pkg_name)


def install_one(pkg: dict, source_root: Path, target: Path | None,
                force: bool, agent: str | None = None,
                refresh: bool = False) -> str:
    dest = dest_for(pkg, target)
    receipt = receipt_at(dest)
    # A --target install is an explicit placement: always refresh it.
    # A managed install (default dir or an agent dir) is a noop when
    # the same version is already there.
    if receipt and receipt.get("version") == pkg["version"] and not force and not refresh:
        where = "for %s " % agent if agent else ""
        return "already installed: %s %s %s-> %s" % (pkg["name"], pkg["version"], where, dest)
    src = source_root / pkg["path"]
    if not src.is_dir():
        raise NewrError("package %s is missing from the source (%s)" % (pkg["name"], pkg["path"]))
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(src, dest)
    data = {
        "name": pkg["name"],
        "type": pkg["type"],
        "version": pkg["version"],
        "source": REPO,
        "installed_at": datetime.now(timezone.utc).isoformat(),
    }
    if agent:
        data["agent"] = agent
    (dest / RECEIPT).write_text(json.dumps(data, indent=2), encoding="utf-8")
    return "installed %s %s -> %s" % (pkg["name"], pkg["version"], dest)


def install_conventions(source_root: Path, dest_dir: Path) -> str:
    """Aider has no skill system, so it gets a CONVENTIONS.md digest
    of the whole pack instead of skill folders."""
    src = source_root / "aider" / CONVENTIONS
    if not src.is_file():
        raise NewrError("the Aider conventions file is missing from the source")
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / CONVENTIONS
    shutil.copyfile(src, dest)
    return ("installed Aider conventions -> %s\n"
            "  Aider has no skill system. Add this file to .aider.conf.yml:\n"
            "    read:\n"
            "      - %s" % (dest, dest))


def parse_agent_flags(args: list) -> tuple:
    """Pull --agent/--project out of an arg list. Returns
    (agent_specs, project, remaining_args)."""
    specs: list = []
    project = False
    rest: list = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--project":
            project = True
            i += 1
        elif arg == "--agent" and i + 1 < len(args):
            specs.append(args[i + 1])
            i += 2
        elif arg.startswith("--agent="):
            specs.append(arg[len("--agent="):])
            i += 1
        else:
            rest.append(arg)
            i += 1
    return specs, project, rest


def cmd_search(args: list) -> int:
    registry = load_registry()
    query = " ".join(args).lower() if args else ""
    rows = [p for p in registry.get("packages", [])
            if not query or query in p["name"].lower() or query in p["description"].lower()]
    if not rows:
        print("no packages match '%s'" % query)
        return 0
    for p in rows:
        installed = installed_receipt(p["name"])
        mark = " [installed %s]" % installed["version"] if installed else ""
        print("%-24s %-8s %s%s" % (p["name"], p["type"], p["description"], mark))
    return 0


def cmd_info(args: list) -> int:
    if len(args) != 1:
        raise NewrError("usage: newr info <package>")
    registry = load_registry()
    pkg = resolve(args[0], registry)
    if pkg["type"] == "bundle":
        print("all: the seven skills in the discord-py-skills pack")
        return 0
    print("name:        %s" % pkg["name"])
    print("type:        %s" % pkg["type"])
    print("version:     %s" % pkg["version"])
    print("description: %s" % pkg["description"])
    print("path:        %s" % pkg["path"])
    receipt = installed_receipt(pkg["name"])
    if receipt:
        print("installed:   %s (%s)" % (receipt["version"], receipt["installed_at"]))
    else:
        print("installed:   no")
    table = agent_table(registry)
    hits = []
    for name in table:
        if is_conventions_agent(name, table):
            continue
        for base in agent_dirs(name, table, project=False):
            if receipt_at(base / pkg["name"]):
                hits.append(name)
                break
    if hits:
        print("also installed for agents: %s" % ", ".join(sorted(set(hits))))
    return 0


def cmd_install(args: list) -> int:
    specs, project, rest = parse_agent_flags(args)
    force = "--force" in rest
    target = None
    names = []
    i = 0
    while i < len(rest):
        if rest[i] == "--force":
            i += 1
        elif rest[i] == "--target" and i + 1 < len(rest):
            target = Path(rest[i + 1])
            i += 2
        elif rest[i].startswith("--target="):
            target = Path(rest[i][len("--target="):])
            i += 1
        else:
            names.append(rest[i])
            i += 1
    if not names:
        raise NewrError("usage: newr install <package>... | newr install all")
    if target is not None and len(names) > 1:
        raise NewrError("--target installs one package at a time")
    if target is not None and specs:
        raise NewrError("use --agent or --target, not both")
    registry = load_registry()
    wanted = []
    for name in names:
        pkg = resolve(name, registry)
        if pkg["type"] == "bundle":
            wanted.extend(p for p in registry.get("packages", []) if p["type"] == "skill")
        else:
            wanted.append(pkg)
    seen = set()
    wanted = [p for p in wanted if not (p["name"] in seen or seen.add(p["name"]))]
    source_root = package_source(registry)
    if not specs:
        # Plain install: default behaviour, unchanged.
        if project:
            specs = ["agents"]
        else:
            for pkg in wanted:
                print(install_one(pkg, source_root, target, force,
                                  refresh=target is not None))
            return 0
    table = agent_table(registry)
    agents = []
    for spec in specs:
        agents.extend(resolve_agent_spec(spec, table))
    agents = list(dict.fromkeys(agents))
    if not agents:
        raise NewrError("no agent detected on this machine. "
                        "Pick one explicitly: newr install --agent claude-code <package>")
    if any(p["type"] == "template" for p in wanted):
        raise NewrError("templates cannot install into an agent skill directory. "
                        "Install a template without --agent (it goes into the current directory).")
    for agent in agents:
        if is_conventions_agent(agent, table):
            for base in agent_dirs(agent, table, project):
                print(install_conventions(source_root, base))
            continue
        for base in agent_dirs(agent, table, project):
            for pkg in wanted:
                print(install_one(pkg, source_root, base / pkg["name"],
                                  force, agent=agent))
    return 0


def cmd_uninstall(args: list) -> int:
    specs, project, rest = parse_agent_flags(args)
    if not rest:
        raise NewrError("usage: newr uninstall <package>...")
    if not specs:
        if project:
            raise NewrError("newr uninstall --project needs --agent: "
                            "newr uninstall --agent <name> --project <package>")
        for name in rest:
            dest = skills_dir() / name
            if dest.is_dir():
                shutil.rmtree(dest)
                print("uninstalled %s" % name)
            else:
                print("not installed: %s" % name)
        return 0
    registry = load_registry()
    table = agent_table(registry)
    agents = []
    for spec in specs:
        agents.extend(resolve_agent_spec(spec, table))
    for agent in dict.fromkeys(agents):
        for base in agent_dirs(agent, table, project):
            for name in rest:
                dest = base / name
                if dest.is_dir():
                    shutil.rmtree(dest)
                    print("uninstalled %s (for %s)" % (name, agent))
                else:
                    print("not installed: %s (for %s)" % (name, agent))
    return 0


def cmd_list(args: list) -> int:
    specs, project, rest = parse_agent_flags(args)
    if rest:
        raise NewrError("usage: newr list [--agent <name>] [--project]")
    if not specs:
        if project:
            specs = ["agents"]
        else:
            return list_dir(skills_dir())
    registry = load_registry()
    table = agent_table(registry)
    agents = []
    for spec in specs:
        agents.extend(resolve_agent_spec(spec, table))
    for agent in dict.fromkeys(agents):
        for base in agent_dirs(agent, table, project):
            if is_conventions_agent(agent, table):
                dest = base / CONVENTIONS
                print("%s: %s" % (agent, "installed" if dest.is_file() else "not installed"))
                continue
            print("# %s (%s)" % (agent, base))
            list_dir(base)
    return 0


def list_dir(base: Path) -> int:
    if not base.is_dir():
        print("nothing installed yet. Run `newr search`, then `newr install <package>`.")
        return 0
    found = False
    for child in sorted(base.iterdir()):
        if not child.is_dir():
            continue
        receipt = receipt_at(child)
        if receipt:
            print("%-24s %-8s %s" % (receipt["name"], receipt["version"], child))
            found = True
    if not found:
        print("nothing installed yet. Run `newr search`, then `newr install <package>`.")
    return 0


def cmd_update(args: list) -> int:
    registry = load_registry(refresh=True)
    print("registry %s" % registry.get("version", "?"))
    table = agent_table(registry)
    # Every managed skill dir: the default one plus each agent's user
    # dirs (deduped). Project dirs are inside repos, so they are
    # updated by re-running install --project, not here.
    dirs: list = [(None, skills_dir())]
    for name in table:
        if is_conventions_agent(name, table):
            continue
        for base in agent_dirs(name, table, project=False):
            if (name, base) not in dirs:
                dirs.append((name, base))
    wanted: list = []
    for agent, base in dirs:
        if not base.is_dir():
            continue
        for child in sorted(base.iterdir()):
            if not child.is_dir():
                continue
            receipt = receipt_at(child)
            if not receipt:
                continue
            pkg = packages(registry).get(child.name)
            if pkg and pkg["version"] != receipt.get("version"):
                wanted.append((agent, pkg))
    if not wanted:
        print("everything is up to date")
        return 0
    source_root = package_source(registry)
    for agent, pkg in wanted:
        if agent is None:
            print(install_one(pkg, source_root, None, force=True))
        else:
            for base in agent_dirs(agent, table, project=False):
                dest = base / pkg["name"]
                if receipt_at(dest) and receipt_at(dest).get("version") != pkg["version"]:
                    print(install_one(pkg, source_root, dest, force=True, agent=agent))
    return 0


def cmd_agents(args: list) -> int:
    registry = load_registry()
    table = agent_table(registry)
    detected = set(detect_agents(table))
    print("%-14s %-8s %-28s %s" % ("agent", "detected", "user skill dir", "project skill dir"))
    for name, entry in table.items():
        user = ", ".join(entry.get("user", []))
        project = ", ".join(entry.get("project", []))
        mark = "yes" if name in detected else "no"
        print("%-14s %-8s %-28s %s" % (name, mark, user, project))
    print()
    print("Install examples:")
    print("  newr install --agent claude-code all")
    print("  newr install --agent auto all        (only the agents detected above)")
    print("  newr install --agent copilot --project testing")
    print("Aider has no skill system; --agent aider installs CONVENTIONS.md instead.")
    return 0


def cmd_version(args: list) -> int:
    print("newr %s" % VERSION)
    return 0


HELP = """newr - the package manager for the discord-py-skills pack

Usage: newr <command> [args]

  search [query]    list installable packages (skills and templates)
  info <package>    show a package's details and install state
  install <pkg>...  install packages; `all` installs the seven skills
                    options: --target <dir>, --force,
                             --agent <name>[,<name>...] | --agent all | --agent auto,
                             --project (install into the project, not $HOME)
  uninstall <pkg>.. remove installed skills (also: --agent <name> [--project])
  list [--agent ..] show installed skills (default dir, or an agent's dir)
  agents            list supported agents, their skill dirs, and detection
  update            refresh the registry and update installed skills
  build <file.newr> build a .newr bot into runnable discord.py
                    options: --check, -o/--output <file.py>
  version           print the newr version
  help [command]    show this help, or help for one command

Skills install to ~/.newr/skills/<name> (NEWR_HOME overrides the
prefix). Templates install into the current directory. No account,
no token, no build step.

Agents: claude-code, codex, cursor, windsurf, copilot, gemini,
opencode, kilo, cline, zed, qwen, kimi, kiro, junie, roo, continue,
muse, grok, tabnine, amp, vibe, trae, crush, goose, factory, augment,
antigravity, zcode, deepseek, openclaw, pi, agents (shared
~/.agents/skills, read by 20+ agents), aider (CONVENTIONS.md digest;
Aider has no skill system). Run `newr agents` for the full list with
skill directories and detection.
"""


def cmd_help(args: list) -> int:
    print(HELP, end="")
    return 0


COMMANDS = {
    "search": cmd_search,
    "info": cmd_info,
    "install": cmd_install,
    "uninstall": cmd_uninstall,
    "list": cmd_list,
    "agents": cmd_agents,
    "update": cmd_update,
    "build": cmd_build,
    "version": cmd_version,
    "help": cmd_help,
}


def main(argv: list) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        return cmd_help([])
    cmd = argv[0]
    if cmd in ("-v", "--version"):
        return cmd_version([])
    fn = COMMANDS.get(cmd)
    if fn is None:
        print("newr: unknown command '%s'. Run `newr help`." % cmd, file=sys.stderr)
        return 2
    try:
        return fn(argv[1:])
    except NewrError as exc:
        print("newr: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
